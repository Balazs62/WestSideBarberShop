# Netlify Production Environment Variables
# Copy this file to .env.production and fill in the actual values
# Add these variables in Netlify Dashboard: Site Settings > Environment Variables

# Clerk Authentication Configuration
# Get these from Clerk Dashboard: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Default Admin User Configuration
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=

# Google OAuth Configuration (Client-side)
# Get these from Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# Application Configuration
VITE_APP_URL=https://yourdomain.com
VITE_APP_NAME=BarberShop

# Optional: Email Service (if you want to add email notifications later)
VITE_EMAIL_SERVICE_API_KEY=

# Optional: Analytics (if you want to add analytics later)
VITE_GA_TRACKING_ID=
